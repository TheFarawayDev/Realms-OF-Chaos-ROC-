{
  "multipart": [
    {
      "apply": {
        "model": "realms_of_chaos:block/table_top"
      }
    },
    {
      "when": {
        "north": "false",
        "west": "false"
      },
      "apply": {
        "model": "realms_of_chaos:block/table_leg_north_west"
      }
    },
    {
      "when": {
        "north": "false",
        "east": "false"
      },
      "apply": {
        "model": "realms_of_chaos:block/table_leg_north_east"
      }
    },
    {
      "when": {
        "south": "false",
        "west": "false"
      },
      "apply": {
        "model": "realms_of_chaos:block/table_leg_south_west"
      }
    },
    {
      "when": {
        "south": "false",
        "east": "false"
      },
      "apply": {
        "model": "realms_of_chaos:block/table_leg_south_east"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "realms_of_chaos:block/table_apron_north"
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "realms_of_chaos:block/table_apron_south"
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "realms_of_chaos:block/table_apron_west"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "realms_of_chaos:block/table_apron_east"
      }
    }
  ]
}
